generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums
// Enums removed for SQLite compatibility in Prisma 5
// enum Role ...
// enum TicketStatus ...
// enum Priority ...

// Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String? // For credentials auth (dev)
  image         String?
  role          String      @default("TEACHER") // Was Enum Role
  department    String?
  
  ticketsCreated Ticket[]  @relation("CreatedBy")
  ticketsAssigned Ticket[] @relation("AssignedTo")
  newsCreated    News[]
  approvals      Approval[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Ticket {
  id            String       @id @default(cuid())
  title         String
  description   String
  status        String       @default("OPEN") // Was Enum TicketStatus
  priority      String       @default("MEDIUM") // Was Enum Priority
  type          String       // e.g., "IT Support", "Leave Request"
  
  authorId      String
  author        User         @relation("CreatedBy", fields: [authorId], references: [id])
  
  assigneeId    String?
  assignee      User?        @relation("AssignedTo", fields: [assigneeId], references: [id])
  
  approvals     Approval[]
  comments      Comment[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Approval {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  approverId String
  approver   User    @relation(fields: [approverId], references: [id])
  
  status    String // APPROVED or REJECTED
  comment   String?
  
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  
  createdAt DateTime @default(now())
}


model News {
  id          String   @id @default(cuid())
  title       String
  content     String
  published   Boolean  @default(true)
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AssignmentRule {
  id          String   @id @default(cuid())
  sourceRole  String   // Who is assigning?
  targetRole  String   // Who can they assign to?
  
  @@unique([sourceRole, targetRole])
}

model StatusTransitionRule {
  id          String   @id @default(cuid())
  role        String   // Who is changing the status?
  fromStatus  String   // Current status
  toStatus    String   // Allowed new status
  
  @@unique([role, fromStatus, toStatus])
}

