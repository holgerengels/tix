{
    "type": "Aufgabe",
    "template": "{{location}}",
    "fields": [
        {
            "name": "assignee",
            "visible": true
        },
        {
            "name": "location",
            "label": "Ort",
            "type": "Autocomplete",
            "required": true,
            "options": [
                "Raum 101",
                "Raum 102",
                "Raum 201",
                "Raum 202",
                "Raum 203",
                "Raum 204",
                "Raum 205"
            ]
        }
    ],
    "workflow": [
        {
            "states": [
                "offen.neu",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "bearbeiten",
                    "groups": [
                        "@assignee",
                        "Schulleitung",
                        "Netzwerkteam",
                        "Hausmeister"
                    ],
                    "script": "ticket.state = 'offen.inArbeit'",
                    "form": "aufgabe.bearbeiten"
                },
                {
                    "name": "ablehnen",
                    "groups": [
                        "Schulleitung",
                        "Netzwerkteam",
                        "Hausmeister"
                    ],
                    "script": "ticket.state = 'geschlossen.abgelehnt'"
                }
            ]
        },
        {
            "states": [
                "offen.neu",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "stornieren",
                    "groups": [
                        "@creator"
                    ],
                    "optional": true,
                    "script": "ticket.state = 'geschlossen.storniert'"
                }
            ]
        },
        {
            "states": [
                "offen.erledigt",
                "offen.abgelehnt"
            ],
            "actions": [
                {
                    "name": "ok",
                    "groups": [
                        "@creator"
                    ],
                    "script": "ticket.state = 'geschlossen.ok'"
                }
            ]
        }
    ],
    "access": [
        {
            "name": "create",
            "groups": [
                "Lehrkräfte",
                "Hausmeister"
            ]
        },
        {
            "name": "read",
            "groups": [
                "Lehrkräfte",
                "Hausmeister"
            ]
        },
        {
            "name": "delete",
            "groups": [
                "Schulleitung",
                "Netzwerkteam"
            ]
        },
        {
            "name": "comment",
            "groups": [
                "Schulleitung",
                "Netzwerkteam",
                "Hausmeister"
            ]
        }
    ],
    "forms": [
        {
            "name": "aufgabe.bearbeiten",
            "title": "Aufgabe bearbeiten",
            "actions": [
                {
                    "name": "erledigt",
                    "script": "ticket.state = 'offen.erledigt'"
                },
                {
                    "name": "in Arbeit",
                    "script": "ticket.state = 'offen.inArbeit'"
                }
            ]
        }
    ],
    "states": [
        {
            "name": "offen",
            "label": "Offen",
            "color": "blue"
        },
        {
            "name": "offen.neu",
            "label": "Neu",
            "color": "blue"
        },
        {
            "name": "offen.inArbeit",
            "label": "In Arbeit",
            "color": "yellow"
        },
        {
            "name": "offen.erledigt",
            "label": "Erledigt",
            "color": "green"
        },
        {
            "name": "offen.abgelehnt",
            "label": "Abgelehnt",
            "color": "red"
        },
        {
            "name": "geschlossen.storniert",
            "label": "Storniert",
            "color": "red"
        },
        {
            "name": "geschlossen.ok",
            "label": "Geschlossen",
            "color": "green"
        },
        {
            "name": "geschlossen.abgelehnt",
            "label": "Abgelehnt",
            "color": "green"
        },
        {
            "name": "geschlossen",
            "label": "Geschlossen",
            "color": "green"
        }
    ]
}