{
    "type": "Abwesenheitsantrag",
    "abbreviation": "ABW",
    "template": "{{dateFrom}} S {{lessonFrom}} - {{dateUntil}} S {{lessonUntil}} ({{reason}})",
    "fields": [
        {
            "name": "dateFrom",
            "label": "Datum von",
            "type": "Date",
            "required": true,
            "validation": {
                "expression": "!ticket.dateFrom || ticket.dateFrom > new Date().toLocaleDateString('en-CA')",
                "message": "Datum von kann nicht in der Vergangenheit liegen"
            }
        },
        {
            "name": "lessonFrom",
            "label": "Stunde von",
            "type": "Lesson",
            "required": true,
            "indicator": "{{ticket.dateUntil > ticket.dateFrom ? 'from' : ''}}"
        },
        {
            "name": "dateUntil",
            "label": "Datum bis",
            "type": "Date",
            "required": true
        },
        {
            "name": "lessonUntil",
            "label": "Stunde bis",
            "type": "Lesson",
            "required": true,
            "indicator": "{{ticket.dateUntil > ticket.dateFrom ? 'until' : ''}}"
        },
        {
            "name": "reason",
            "label": "Grund",
            "type": "Select",
            "required": true,
            "options": [
                "Dienstgeschäft",
                "Fortbildung"
            ]
        },
        {
            "name": "description",
            "label": "Bemerkung"
        }
    ],
    "validations": [
        {
            "name": "dateRange",
            "expression": "!ticket.dateFrom || !ticket.dateUntil || ticket.dateFrom <= ticket.dateUntil",
            "message": "Datum von kann nicht nach Datum bis liegen"
        }
    ],
    "grid": [
        "title title title title",
        "badges badges badges badges",
        "dateFrom dateFrom lessonFrom lessonFrom",
        "dateUntil dateUntil lessonUntil lessonUntil",
        "reason reason reason reason",
        "description description description description"
    ],
    "workflow": [
        {
            "states": [
                "offen.neu"
            ],
            "actions": [
                {
                    "name": "genehmigen",
                    "groups": [
                        "Schulleitung"
                    ],
                    "script": "ticket.state = 'offen.genehmigt'"
                },
                {
                    "name": "ablehnen",
                    "groups": [
                        "Schulleitung"
                    ],
                    "inlineComment": true,
                    "script": "ticket.state = 'offen.abgelehnt'"
                }
            ]
        },
        {
            "states": [
                "offen.genehmigt",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "bearbeiten",
                    "groups": [
                        "Stundenplanung"
                    ],
                    "form": "abwesenheit.bearbeiten"
                }
            ]
        },
        {
            "states": [
                "offen.neu",
                "offen.genehmigt"
            ],
            "actions": [
                {
                    "name": "stornieren",
                    "groups": [
                        "@creator"
                    ],
                    "optional": true,
                    "script": "ticket.state = 'geschlossen.storniert'"
                }
            ]
        },
        {
            "states": [
                "offen.erledigt",
                "offen.abgelehnt"
            ],
            "actions": [
                {
                    "name": "ok",
                    "groups": [
                        "@creator"
                    ],
                    "script": "ticket.state = 'geschlossen.ok'"
                }
            ]
        }
    ],
    "access": [
        {
            "name": "create",
            "groups": [
                "Lehrkräfte"
            ]
        },
        {
            "name": "edit",
            "groups": [
                "Schulleitung"
            ]
        },
        {
            "name": "read",
            "groups": [
                "@creator",
                "Schulleitung",
                "Stundenplanung"
            ]
        },
        {
            "name": "undo",
            "groups": [
                "Schulleitung",
                "Stundenplanung"
            ]
        },
        {
            "name": "delete",
            "groups": [
                "Schulleitung"
            ]
        },
        {
            "name": "comment",
            "groups": [
                "Schulleitung",
                "Stundenplanung"
            ]
        }
    ],
    "bots": [
        {
            "name": "dringend",
            "states": [
                "offen.neu",
                "offen.genehmigt",
                "offen.inArbeit"
            ],
            "function": "dringend"
        }
    ],
    "forms": [
        {
            "name": "abwesenheit.bearbeiten",
            "title": "Abwesenheit bearbeiten",
            "fields": [
                {
                    "name": "badges",
                    "visible": true
                }
            ],
            "actions": [
                {
                    "name": "erledigt",
                    "script": "ticket.state = 'offen.erledigt'"
                },
                {
                    "name": "in Arbeit",
                    "script": "ticket.state = 'offen.inArbeit'"
                }
            ]
        }
    ],
    "states": [
        {
            "name": "offen",
            "label": "offen",
            "color": "blue"
        },
        {
            "name": "offen.neu",
            "label": "neu",
            "color": "blue"
        },
        {
            "name": "offen.genehmigt",
            "label": "genehmigt",
            "color": "yellow"
        },
        {
            "name": "offen.inArbeit",
            "label": "in Arbeit",
            "color": "yellow"
        },
        {
            "name": "offen.erledigt",
            "label": "erledigt",
            "color": "green"
        },
        {
            "name": "offen.abgelehnt",
            "label": "abgelehnt",
            "color": "red"
        },
        {
            "name": "geschlossen.storniert",
            "label": "storniert",
            "color": "red"
        },
        {
            "name": "geschlossen.ok",
            "label": "geschlossen",
            "color": "green"
        },
        {
            "name": "geschlossen",
            "label": "geschlossen",
            "color": "green"
        }
    ]
}