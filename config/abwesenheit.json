{
    "type": "Abwesenheit",
    "template": "{{dateFrom}} {{timeFrom}} - {{dateUntil}} {{timeUntil}} ({{reason}})",
    "fields": [
        {
            "name": "dateFrom",
            "label": "Datum von",
            "type": "Date",
            "required": true
        },
        {
            "name": "timeFrom",
            "label": "Zeit von",
            "type": "Time",
            "required": true
        },
        {
            "name": "dateUntil",
            "label": "Datum bis",
            "type": "Date",
            "required": true
        },
        {
            "name": "timeUntil",
            "label": "Zeit bis",
            "type": "Time",
            "required": true
        },
        {
            "name": "reason",
            "label": "Grund",
            "type": "Select",
            "required": true,
            "options": [
                "Dienstgeschäft",
                "Fortbildung"
            ]
        }
    ],
    "workflow": [
        {
            "states": [
                "offen.neu"
            ],
            "actions": [
                {
                    "name": "genehmigen",
                    "groups": [
                        "Schulleitung"
                    ],
                    "script": "ticket.state = 'offen.genehmigt'"
                },
                {
                    "name": "ablehnen",
                    "groups": [
                        "Schulleitung"
                    ],
                    "script": "ticket.state = 'offen.abgelehnt'"
                }
            ]
        },
        {
            "states": [
                "offen.genehmigt",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "bearbeiten",
                    "groups": [
                        "Stundenplanung"
                    ],
                    "form": "abwesenheit.bearbeiten"
                }
            ]
        },
        {
            "states": [
                "offen.neu",
                "offen.genehmigt"
            ],
            "actions": [
                {
                    "name": "stornieren",
                    "groups": [
                        "@creator"
                    ],
                    "optional": true,
                    "script": "ticket.state = 'geschlossen.storniert'"
                }
            ]
        },
        {
            "states": [
                "offen.erledigt",
                "offen.abgelehnt"
            ],
            "actions": [
                {
                    "name": "ok",
                    "groups": [
                        "@creator"
                    ],
                    "script": "ticket.state = 'geschlossen.ok'"
                }
            ]
        }
    ],
    "access": [
        {
            "name": "create",
            "groups": [
                "Lehrkräfte"
            ]
        },
        {
            "name": "read",
            "groups": [
                "Schulleitung",
                "Stundenplanung"
            ]
        },
        {
            "name": "delete",
            "groups": [
                "Schulleitung"
            ]
        },
        {
            "name": "comment",
            "groups": [
                "Schulleitung",
                "Stundenplanung"
            ]
        }
    ],
    "forms": [
        {
            "name": "abwesenheit.bearbeiten",
            "title": "Abwesenheit bearbeiten",
            "actions": [
                {
                    "name": "erledigt",
                    "script": "ticket.state = 'offen.erledigt'"
                },
                {
                    "name": "in Arbeit",
                    "script": "ticket.state = 'offen.inArbeit'"
                }
            ]
        }
    ],
    "states": [
        {
            "name": "offen",
            "label": "Offen",
            "color": "blue"
        },
        {
            "name": "offen.neu",
            "label": "Neu",
            "color": "blue"
        },
        {
            "name": "offen.genehmigt",
            "label": "Genehmigt",
            "color": "yellow"
        },
        {
            "name": "offen.inArbeit",
            "label": "In Arbeit",
            "color": "yellow"
        },
        {
            "name": "offen.erledigt",
            "label": "Erledigt",
            "color": "green"
        },
        {
            "name": "offen.abgelehnt",
            "label": "Abgelehnt",
            "color": "red"
        },
        {
            "name": "geschlossen.storniert",
            "label": "Storniert",
            "color": "red"
        },
        {
            "name": "geschlossen.ok",
            "label": "Geschlossen",
            "color": "green"
        },
        {
            "name": "geschlossen",
            "label": "Geschlossen",
            "color": "green"
        }
    ]
}