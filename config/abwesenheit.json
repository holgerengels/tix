{
    "type": "Abwesenheit",
    "fields": [
        {
            "name": "Datum-von",
            "type": "Datum",
            "required": true
        },
        {
            "name": "Zeit-von",
            "type": "Zeit",
            "required": true
        },
        {
            "name": "Datum-bis",
            "type": "Datum",
            "required": true
        },
        {
            "name": "Zeit-bis",
            "type": "Zeit",
            "required": true
        },
        {
            "name": "Grund",
            "type": "Auswahl",
            "required": true,
            "options": [
                "Dienstgeschäft",
                "Fortbildung"
            ]
        }
    ],
    "workflow": [
        {
            "states": [
                "offen.neu"
            ],
            "actions": [
                {
                    "name": "genehmigen",
                    "groups": [
                        "Schulleitung"
                    ],
                    "script": "ticket.state = 'offen.genehmigt'"
                },
                {
                    "name": "ablehnen",
                    "groups": [
                        "Schulleitung"
                    ],
                    "script": "ticket.state = 'offen.abgelehnt'"
                }
            ]
        },
        {
            "states": [
                "offen.genehmigt",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "bearbeiten",
                    "groups": [
                        "Vertretungsplan"
                    ],
                    "form": "abwesenheit.bearbeiten"
                }
            ]
        },
        {
            "states": [
                "offen.neu",
                "offen.genehmigt"
            ],
            "actions": [
                {
                    "name": "stornieren",
                    "groups": [
                        "@creator"
                    ],
                    "script": "ticket.state = 'geschlossen.storniert'"
                }
            ]
        },
        {
            "states": [
                "offen.bearbeitet",
                "offen.abgelehnt"
            ],
            "actions": [
                {
                    "name": "ok",
                    "groups": [
                        "@creator"
                    ],
                    "script": "ticket.state = 'geschlossen.ok'"
                }
            ]
        }
    ],
    "access": [
        {
            "name": "create",
            "groups": [
                "Lehrkräfte",
                "Admin"
            ]
        },
        {
            "name": "read",
            "groups": [
                "Schulleitung",
                "Admin"
            ]
        },
        {
            "name": "delete",
            "groups": [
                "Schulleitung",
                "Admin"
            ]
        }
    ],
    "forms": [
        {
            "name": "abwesenheit.bearbeiten",
            "title": "Abwesenheit bearbeiten",
            "actions": [
                {
                    "name": "fertig",
                    "script": "ticket.state = 'offen.bearbeitet'"
                },
                {
                    "name": "nicht fertig",
                    "script": "ticket.state = 'offen.inArbeit'"
                }
            ]
        }
    ]
}