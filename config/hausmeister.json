        "title title title title",
        "badges badges badges badges",
        "description description description description",
        "location location category category",
        "attachments attachments attachments attachments"
    ],
    "workflow": [
        {
            "states": [
                "offen.neu"
            ],
            "actions": [
                {
                    "name": "genehmigen",
                    "groups": [
                        "Schulleitung"
                    ],
                    "script": "ticket.state = 'offen.genehmigt'"
                },
                {
                    "name": "ablehnen",
                    "groups": [
                        "Schulleitung"
                    ],
                    "inline": "comment",
                    "script": "ticket.state = 'offen.abgelehnt'"
                }
            ]
        },
        {
            "states": [
                "offen.genehmigt",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "bearbeiten",
                    "groups": [
                        "Hausmeister"
                    ],
                    "form": "bearbeiten"
                }
            ]
        },
        {
            "states": [
                "offen.neu",
                "offen.genehmigt"
            ],
            "actions": [
                {
                    "name": "stornieren",
                    "groups": [
                        "@creator"
                    ],
                    "optional": true,
                    "script": "ticket.state = 'geschlossen.storniert'"
                }
            ]
        },
        {
            "states": [
                "offen.erledigt",
                "offen.abgelehnt"
            ],
            "actions": [
                {
                    "name": "ok",
                    "groups": [
                        "@creator"
                    ],
                    "script": "ticket.state = 'geschlossen.ok'"
                }
            ]
        }
    ],
    "bots": [
        {
            "name": "automatisch_genehmigen",
            "states": [
                "offen.neu"
            ],
            "script": "await automatisch_genehmigen(ticket)"
        },
        {
            "name": "raum_erkennung",
            "states": [
                "offen.neu"
            ],
            "onChange": "async",
            "script": "await raum_erkennung(ticket)"
        }
    ],
    "access": [
        {
            "name": "create",
            "groups": [
                "Lehrkräfte",
                "Sekretariat",
                "Hausmeister",
                "Mensa",
                "IT-Support"
            ]
        },
        {
            "name": "edit",
            "groups": [
                "Schulleitung"
            ]
        },
        {
            "name": "read",
            "groups": [
                "@creator",
                "Lehrkräfte",
                "Sekretariat",
                "Hausmeister",
                "Mensa",
                "IT-Support"
            ]
        },
        {
            "name": "undo",
            "groups": [
                "Schulleitung",
                "Netzwerkteam"
            ]
        },
        {
            "name": "delete",
            "groups": [
                "Schulleitung"
            ]
        },
        {
            "name": "comment",
            "groups": [
                "@creator",
                "Schulleitung",
                "Netzwerkteam",
                "Hausmeister",
                "IT-Support"
            ]
        }
    ],
    "forms": [
        {
            "name": "bearbeiten",
            "title": "bearbeiten",
            "fields": [
                {
                    "name": "badges",
                    "visible": true
                }
            ],
            "actions": [
                {
                    "name": "erledigt",
                    "script": "ticket.state = 'offen.erledigt'"
                },
                {
                    "name": "in Arbeit",
                    "script": "ticket.state = 'offen.inArbeit'"
                }
            ]
        }
    ],
    "states": [
        {
            "name": "offen",
            "label": "offen",
            "color": "blue"
        },
        {
            "name": "offen.neu",
            "label": "neu",
            "color": "blue"
        },
        {
            "name": "offen.genehmigt",
            "label": "genehmigt",
