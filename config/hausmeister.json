{
    "type": "Hausmeisterauftrag",
    "abbreviation": "HMA",
    "template": "{{category}}",
    "fields": [
        {
            "name": "category",
            "label": "Kategorie",
            "type": "Select",
            "required": true,
            "options": [
                "Veranstaltung",
                "Reparatur",
                "Reinigung",
                "Entsorgung",
                "Sonstiges"
            ]
        }
    ],
    "grid": [
        "title title title title",
        "badges badges badges badges",
        "description description description description",
        "category category category category"
    ],
    "workflow": [
        {
            "states": [
                "offen.neu"
            ],
            "actions": [
                {
                    "name": "genehmigen",
                    "groups": [
                        "Schulleitung"
                    ],
                    "script": "ticket.state = 'offen.genehmigt'"
                },
                {
                    "name": "ablehnen",
                    "groups": [
                        "Schulleitung"
                    ],
                    "inlineComment": true,
                    "script": "ticket.state = 'offen.abgelehnt'"
                }
            ]
        },
        {
            "states": [
                "offen.genehmigt",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "bearbeiten",
                    "groups": [
                        "Hausmeister"
                    ],
                    "form": "bearbeiten"
                }
            ]
        },
        {
            "states": [
                "offen.neu",
                "offen.genehmigt"
            ],
            "actions": [
                {
                    "name": "stornieren",
                    "groups": [
                        "@creator"
                    ],
                    "optional": true,
                    "script": "ticket.state = 'geschlossen.storniert'"
                }
            ]
        },
        {
            "states": [
                "offen.erledigt",
                "offen.abgelehnt"
            ],
            "actions": [
                {
                    "name": "ok",
                    "groups": [
                        "@creator"
                    ],
                    "script": "ticket.state = 'geschlossen.ok'"
                }
            ]
        }
    ],
    "bots": [
        {
            "name": "automatisch_genehmigen",
            "states": [
                "offen.neu"
            ],
            "function": "automatisch_genehmigen"
        }
    ],
    "access": [
        {
            "name": "create",
            "groups": [
                "Lehrkräfte"
            ]
        },
        {
            "name": "edit",
            "groups": [
                "Schulleitung"
            ]
        },
        {
            "name": "read",
            "groups": [
                "@creator",
                "Schulleitung",
                "Netzwerkteam",
                "Hausmeister"
            ]
        },
        {
            "name": "undo",
            "groups": [
                "Schulleitung",
                "Netzwerkteam"
            ]
        },
        {
            "name": "delete",
            "groups": [
                "Schulleitung"
            ]
        },
        {
            "name": "comment",
            "groups": [
                "Schulleitung",
                "Netzwerkteam",
                "Hausmeister"
            ]
        }
    ],
    "forms": [
        {
            "name": "bearbeiten",
            "title": "bearbeiten",
            "fields": [
                {
                    "name": "badges",
                    "visible": true
                }
            ],
            "actions": [
                {
                    "name": "erledigt",
                    "script": "ticket.state = 'offen.erledigt'"
                },
                {
                    "name": "in Arbeit",
                    "script": "ticket.state = 'offen.inArbeit'"
                }
            ]
        }
    ],
    "states": [
        {
            "name": "offen",
            "label": "offen",
            "color": "blue"
        },
        {
            "name": "offen.neu",
            "label": "neu",
            "color": "blue"
        },
        {
            "name": "offen.genehmigt",
            "label": "genehmigt",
            "color": "yellow"
        },
        {
            "name": "offen.inArbeit",
            "label": "in Arbeit",
            "color": "yellow"
        },
        {
            "name": "offen.erledigt",
            "label": "erledigt",
            "color": "green"
        },
        {
            "name": "offen.abgelehnt",
            "label": "abgelehnt",
            "color": "red"
        },
        {
            "name": "geschlossen.storniert",
            "label": "storniert",
            "color": "red"
        },
        {
            "name": "geschlossen.ok",
            "label": "geschlossen",
            "color": "green"
        },
        {
            "name": "geschlossen",
            "label": "geschlossen",
            "color": "green"
        }
    ]
}