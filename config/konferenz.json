{
    "type": "Konferenz",
    "abbreviation": "KNF",
    "subTickets": [
        {
            "type": "Raumreservierung",
            "mapping": {
                "title": "{{ ticket.title }}",
                "date": "{{ ticket.date }}",
                "termin.start": "{{ ticket.timeStart }}",
                "termin.end": "{{ ticket.timeEnd }}"
            },
            "logStatusToParent": true
        },
        {
            "type": "Bewirtungsauftrag",
            "mapping": {
                "title": "{{ ticket.title }}",
                "date": "{{ ticket.date }}",
                "numberOfPersons": "{{ (ticket.participants || []).length }}",
                "breakfastTime": "{{ ticket.timeStart }}",
                "endTime": "{{ ticket.timeEnd }}"
            },
            "logStatusToParent": true
        }
    ],
    "template": "{{ticket.title}} - {{ticket.date}}",
    "fields": [
        {
            "name": "date",
            "label": "Datum",
            "type": "Date",
            "required": true,
            "validation": {
                "expression": "ticket.state || !ticket.date || ticket.date >= format(now, 'yyyy-MM-dd')",
                "message": "Datum kann nicht in der Vergangenheit liegen"
            }
        },
        {
            "name": "timeStart",
            "label": "Beginn",
            "type": "Time",
            "required": true
        },
        {
            "name": "timeEnd",
            "label": "Ende",
            "type": "Time",
            "required": true
        },
        {
            "name": "participants",
            "label": "Teilnehmer*innen",
            "type": "ObjectArray",
            "items": {
                "fields": [
                    {
                        "name": "name",
                        "label": "Name",
                        "type": "User",
                        "groups": [
                            "Lehrkräfte"
                        ]
                    },
                    {
                        "name": "email",
                        "label": "E-Mail",
                        "type": "Email",
                        "default": "{{ lookupUserEmail(name) }}"
                    },
                    {
                        "name": "status",
                        "label": "Status",
                        "type": "Select",
                        "options": [
                            "eingeladen",
                            "anwesend",
                            "entschuldigt",
                            "abwesend"
                        ],
                        "default": "eingeladen",
                        "visible": "{{ ticket.state === 'geschlossen.ok' }}"
                    }
                ],
                "validation": {
                    "expression": "name || email",
                    "message": "Name oder E-Mail muss angegeben werden"
                }
            }
        },
        {
            "name": "agenda",
            "label": "Tagesordnung",
            "type": "RichText"
        },
        {
            "name": "protocol",
            "label": "Protokoll",
            "type": "RichText",
            "visible": "{{ ticket.state && ticket.state !== 'offen.neu' }}"
        },
        {
            "name": "attachments",
            "label": "Anhänge",
            "type": "Attachments",
            "visible": "{{ ticket.state && ticket.state !== 'offen.neu' }}"
        },
        {
            "name": "description",
            "visible": false
        }
    ],
    "grid": [
        "title title title title",
        "date date timeStart timeEnd",
        "participants participants participants participants",
        "agenda agenda agenda agenda",
        "protocol protocol protocol protocol",
        "attachments attachments attachments attachments"
    ],
    "workflow": [
        {
            "states": [
                "offen.eingetragen"
            ],
            "actions": [
                {
                    "name": "ändern",
                    "groups": [
                        "@creator",
                        "Schulleitung",
                        "Netzwerkteam"
                    ],
                    "optional": true,
                    "form": "aendern"
                },
                {
                    "name": "protokollieren",
                    "groups": [
                        "@creator",
                        "Schulleitung",
                        "Netzwerkteam"
                    ],
                    "form": "protokollieren"
                },
                {
                    "name": "stornieren",
                    "groups": [
                        "@creator",
                        "Schulleitung",
                        "Netzwerkteam"
                    ],
                    "optional": true,
                    "script": "ticket.state = 'offen.storniert'"
                },
                {
                    "name": "Subticket erstellen",
                    "groups": [
                        "@creator",
                        "Schulleitung",
                        "Netzwerkteam"
                    ],
                    "subTickets": [
                        "Raumreservierung",
                        "Bewirtungsauftrag"
                    ]
                }
            ]
        }
    ],
    "access": [
        {
            "name": "create",
            "groups": [
                "Schulleitung",
                "Netzwerkteam"
            ]
        },
        {
            "name": "read",
            "groups": [
                "@creator",
                "Schulleitung",
                "Netzwerkteam"
            ]
        },
        {
            "name": "edit",
            "groups": [
                "Schulleitung",
                "Netzwerkteam"
            ]
        },
        {
            "name": "delete",
            "groups": [
                "Schulleitung",
                "Netzwerkteam"
            ]
        },
        {
            "name": "comment",
            "groups": [
                "@creator",
                "Schulleitung",
                "Netzwerkteam"
            ]
        }
    ],
    "bots": [
        {
            "name": "eintragen",
            "states": [
                "offen.neu"
            ],
            "script": "await eintragen(ticket)"
        },
        {
            "name": "stornieren",
            "states": [
                "offen.storniert"
            ],
            "script": "await stornieren(ticket)"
        },
        {
            "name": "syncDate",
            "states": [
                "offen.eingetragen"
            ],
            "onChange": "insync",
            "script": "await syncDate(ticket)"
        },
        {
            "name": "abschliessen",
            "states": [
                "offen.eingetragen"
            ],
            "onChange": "async",
            "schedule": "0 1 * * *",
            "script": "await abschliessen(ticket)"
        },
        {
            "name": "checkResponses",
            "states": [
                "offen.eingetragen"
            ],
            "onChange": "async",
            "schedule": "*/15 * * * *",
            "script": "await checkResponses(ticket)"
        }
    ],
    "forms": [
        {
            "name": "aendern",
            "title": "Konferenzangaben ändern",
            "actions": [
                {
                    "name": "Änderungen speichern",
                    "script": "ticket.state = 'offen.eingetragen'"
                }
            ]
        },
        {
            "name": "protokollieren",
            "title": "Konferenz protokollieren",
            "fields": [
                {
                    "name": "participants",
                    "label": "Anwesenheit prüfen",
                    "required": true,
                    "fixedLength": true,
                    "fixedOrder": true,
                    "items": {
                        "fields": [
                            {
                                "name": "name",
                                "readonly": true
                            },
                            {
                                "name": "status",
                                "label": "Status",
                                "type": "Select",
                                "options": [
                                    "eingeladen",
                                    "anwesend",
                                    "entschuldigt",
                                    "abwesend"
                                ],
                                "default": "eingeladen",
                                "visible": true
                            }
                        ]
                    }
                },
                {
                    "name": "protocol",
                    "required": true
                },
                {
                    "name": "attachments"
                }
            ],
            "actions": [
                {
                    "name": "Konferenz abschließen",
                    "script": "ticket.state = 'geschlossen.ok'"
                }
            ]
        }
    ],
    "states": [
        {
            "name": "offen.*",
            "label": "offen (alle)",
            "color": "blue"
        },
        {
            "name": "offen.neu",
            "label": "neu",
            "color": "blue"
        },
        {
            "name": "offen.eingetragen",
            "label": "eingetragen",
            "color": "green"
        },
        {
            "name": "offen.storniert",
            "label": "austragen",
            "color": "blue"
        },
        {
            "name": "geschlossen.ok",
            "label": "abgeschlossen",
            "color": "green"
        },
        {
            "name": "geschlossen.storniert",
            "label": "storniert",
            "color": "red"
        },
        {
            "name": "geschlossen.*",
            "label": "geschlossen (alle)",
            "color": "green"
        }
    ]
}