{
    "type": "Bewirtungsauftrag",
    "abbreviation": "BWT",
    "template": "{{ticket.title}} - {{ticket.date}}",
    "fields": [
        {
            "name": "title",
            "label": "Veranstaltungsname",
            "type": "Text"
        },
        {
            "name": "description",
            "label": "Bemerkungen"
        },
        {
            "name": "eventType",
            "label": "Art",
            "type": "Select",
            "required": true,
            "options": [
                "intern",
                "extern"
            ]
        },
        {
            "name": "date",
            "label": "Datum",
            "type": "Date",
            "required": true
        },
        {
            "name": "numberOfPersons",
            "label": "Personenanzahl",
            "type": "Integer",
            "required": true
        },
        {
            "name": "room",
            "label": "Raum",
            "type": "Text",
            "required": true
        },
        {
            "name": "breakfast",
            "label": "Frühstück",
            "type": "Boolean"
        },
        {
            "name": "bfDrinksAndFood",
            "label": "Getränke und Speisen",
            "type": "Select",
            "multiple": true,
            "readonly": "{{ticket.breakfast === false}}",
            "options": [
                "Kaffee",
                "Wasser",
                "Orangensaft",
                "Apfelsaft",
                "Tee",
                "Brezeln",
                "Kuchen",
                "Obst",
                "Süße Stückle"
            ]
        },
        {
            "name": "breakfastTime",
            "label": "Bereitstellung bis:",
            "type": "Time",
            "readonly": "{{ticket.breakfast === false}}",
            "required": "{{ticket.breakfast === true}}"
        },
        {
            "name": "lunch",
            "label": "Mittagessen",
            "type": "Boolean"
        },
        {
            "name": "lunchReservation",
            "label": "Tischreservierung",
            "type": "Boolean",
            "readonly": "{{ticket.lunch === false}}"
        },
        {
            "name": "lunchTime",
            "label": "Uhrzeit:",
            "type": "Time",
            "readonly": "{{ticket.lunch === false}}",
            "required": "{{ticket.lunch === true}}"
        },
        {
            "name": "afternoon",
            "label": "Nachmittag",
            "type": "Boolean"
        },
        {
            "name": "afDrinksAndFood",
            "label": "Getränke und Speisen",
            "type": "Select",
            "multiple": true,
            "readonly": "{{ticket.afternoon === false}}",
            "options": [
                "Kaffee",
                "Wasser",
                "Orangensaft",
                "Apfelsaft",
                "Tee",
                "Brezeln",
                "Kuchen",
                "Obst",
                "Süße Stückle"
            ]
        },
        {
            "name": "afternoonTime",
            "label": "Bereitstellung bis:",
            "type": "Time",
            "readonly": "{{ticket.afternoon === false}}",
            "required": "{{ticket.afternoon === true}}"
        }
    ],
    "grid": [
        "title title title title",
        "date date numberOfPersons eventType",
        "room room . .",
        "badges badges badges badges",
        "breakfast bfDrinksAndFood bfDrinksAndFood breakfastTime",
        "lunch lunchReservation lunchReservation lunchTime",
        "afternoon afDrinksAndFood afDrinksAndFood afternoonTime",
        "description description description description"
    ],
    "workflow": [
        {
            "states": [
                "offen.neu"
            ],
            "actions": [
                {
                    "name": "genehmigen",
                    "groups": [
                        "Schulleitung"
                    ],
                    "script": "ticket.state = 'offen.genehmigt'"
                },
                {
                    "name": "ablehnen",
                    "groups": [
                        "Schulleitung"
                    ],
                    "inline": "comment",
                    "script": "ticket.state = 'offen.abgelehnt'"
                }
            ]
        },
        {
            "states": [
                "offen.genehmigt",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "bearbeiten",
                    "groups": [
                        "Mensateam"
                    ],
                    "form": "bearbeiten"
                }
            ]
        },
        {
            "states": [
                "offen.neu",
                "offen.genehmigt"
            ],
            "actions": [
                {
                    "name": "stornieren",
                    "groups": [
                        "@creator"
                    ],
                    "optional": true,
                    "script": "ticket.state = 'geschlossen.storniert'"
                }
            ]
        },
        {
            "states": [
                "offen.erledigt",
                "offen.abgelehnt"
            ],
            "actions": [
                {
                    "name": "ok",
                    "groups": [
                        "@creator"
                    ],
                    "script": "ticket.state = 'geschlossen.ok'"
                }
            ]
        }
    ],
    "access": [
        {
            "name": "create",
            "groups": [
                "Lehrkräfte"
            ]
        },
        {
            "name": "read",
            "groups": [
                "@creator",
                "Schulleitung",
                "Mensateam"
            ]
        },
        {
            "name": "undo",
            "groups": [
                "Schulleitung"
            ]
        },
        {
            "name": "comment",
            "groups": [
                "Schulleitung",
                "Mensateam",
                "@creator"
            ]
        }
    ],
    "bots": [
        {
            "name": "automatisch_genehmigen",
            "states": [
                "offen.neu"
            ],
            "script": "await automatisch_genehmigen(ticket)"
        }
    ],
    "forms": [
        {
            "name": "bearbeiten",
            "title": "bearbeiten",
            "fields": [
                {
                    "name": "badges",
                    "visible": true
                }
            ],
            "actions": [
                {
                    "name": "erledigt",
                    "script": "ticket.state = 'offen.erledigt'"
                },
                {
                    "name": "in Arbeit",
                    "script": "ticket.state = 'offen.inArbeit'"
                }
            ]
        }
    ],
    "states": [
        {
            "name": "offen.*",
            "label": "offen *",
            "color": "blue"
        },
        {
            "name": "offen.neu",
            "label": "neu",
            "color": "blue"
        },
        {
            "name": "offen.inArbeit",
            "label": "in Arbeit",
            "color": "yellow"
        },
        {
            "name": "offen.erledigt",
            "label": "erledigt",
            "color": "green"
        },
        {
            "name": "geschlossen.storniert",
            "label": "storniert",
            "color": "red"
        },
        {
            "name": "geschlossen.ok",
            "label": "ok",
            "color": "green"
        },
        {
            "name": "geschlossen.*",
            "label": "geschlossen (alle)",
            "color": "green"
        }
    ]
}