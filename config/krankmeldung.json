{
    "type": "Krankmeldung",
    "abbreviation": "KRM",
    "template": "{{dateFrom}} - {{dateUntil}}",
    "fields": [
        {
            "name": "dateFrom",
            "label": "Datum von",
            "type": "Date",
            "required": true
        },
        {
            "name": "dateUntil",
            "label": "Datum bis",
            "type": "Date",
            "required": true
        },
        {
            "name": "who",
            "label": "Wer ist krank?",
            "type": "Select",
            "required": true,
            "options": [
                "Ich selbst",
                "Mein Kind"
            ]
        },
        {
            "name": "exam",
            "label": "Prüfungsaufsichten betroffen",
            "type": "Boolean"
        },
        {
            "name": "workAssignment",
            "label": "Folgende Unterrichte sind mit Arbeitsaufträgen versorgt:",
            "hint": "Arbeitsaufträge bitte selbst kommunizieren",
            "type": "RichText",
            "required": false
        },
        {
            "name": "description",
            "label": "Bemerkung"
        }
    ],
    "validations": [
        {
            "name": "dateRange",
            "script": "ticket.dateFrom <= ticket.dateUntil",
            "message": "Datum von kann nicht nach Datum bis liegen"
        }
    ],
    "grid": [
        "title title title title",
        "badges badges badges badges",
        "dateFrom dateFrom dateUntil dateUntil",
        "who who exam exam",
        "workAssignment workAssignment workAssignment workAssignment",
        "description description description description"
    ],
    "workflow": [
        {
            "states": [
                "offen.neu",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "bearbeiten",
                    "groups": [
                        "Stundenplanung"
                    ],
                    "form": "krankmeldung.bearbeiten"
                }
            ]
        },
        {
            "states": [
                "offen.neu"
            ],
            "actions": [
                {
                    "name": "stornieren",
                    "groups": [
                        "@creator"
                    ],
                    "optional": true,
                    "script": "ticket.state = 'geschlossen.storniert'"
                }
            ]
        },
        {
            "states": [
                "offen.erledigt"
            ],
            "actions": [
                {
                    "name": "ok",
                    "groups": [
                        "@creator"
                    ],
                    "script": "ticket.state = 'geschlossen.ok'"
                }
            ]
        }
    ],
    "access": [
        {
            "name": "create",
            "groups": [
                "Lehrkräfte"
            ]
        },
        {
            "name": "read",
            "groups": [
                "@creator",
                "Schulleitung",
                "Stundenplanung"
            ]
        },
        {
            "name": "undo",
            "groups": [
                "Stundenplanung"
            ]
        },
        {
            "name": "comment",
            "groups": [
                "Stundenplanung"
            ]
        }
    ],
    "bots": [
        {
            "name": "dringend",
            "states": [
                "offen.neu",
                "offen.genehmigt",
                "offen.inArbeit"
            ],
            "function": "dringend"
        }
    ],
    "forms": [
        {
            "name": "krankmeldung.bearbeiten",
            "title": "Krankmeldung bearbeiten",
            "fields": [
                {
                    "name": "badges",
                    "visible": true
                }
            ],
            "actions": [
                {
                    "name": "erledigt",
                    "script": "ticket.state = 'offen.erledigt'"
                },
                {
                    "name": "in Arbeit",
                    "script": "ticket.state = 'offen.inArbeit'"
                }
            ]
        }
    ],
    "states": [
        {
            "name": "offen",
            "label": "offen",
            "color": "blue"
        },
        {
            "name": "offen.neu",
            "label": "neu",
            "color": "blue"
        },
        {
            "name": "offen.inArbeit",
            "label": "in Arbeit",
            "color": "yellow"
        },
        {
            "name": "offen.erledigt",
            "label": "erledigt",
            "color": "green"
        },
        {
            "name": "geschlossen.storniert",
            "label": "storniert",
            "color": "red"
        },
        {
            "name": "geschlossen.ok",
            "label": "geschlossen",
            "color": "green"
        },
        {
            "name": "geschlossen",
            "label": "geschlossen",
            "color": "green"
        }
    ]
}