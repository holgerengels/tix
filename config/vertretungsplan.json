{
    "type": "Vertretungsplan-Ticket",
    "abbreviation": "VRP",
    "template": "{{ ((ticket.dateFrom ? ticket.dateFrom : '') + (ticket.lessonFrom ? ' ' + ticket.lessonFrom : '') + (ticket.dateUntil || ticket.lessonUntil ? ' - ' : '') + (ticket.dateUntil ? ticket.dateUntil : '') + (ticket.lessonUntil ? ' ' + ticket.lessonUntil : '')).trim() }}",
    "fields": [
        {
            "name": "assignee",
            "groups": [
                "Stundenplanung",
                "Vertretungsplanung"
            ],
            "visible": true
        },
        {
            "name": "description",
            "required": true
        },
        {
            "name": "dateFrom",
            "label": "Datum von",
            "type": "Date",
            "required": false,
            "validation": {
                "expression": "!ticket.dateFrom || ticket.dateFrom >= format(now, 'yyyy-MM-dd')",
                "message": "Datum von kann nicht in der Vergangenheit liegen"
            }
        },
        {
            "name": "lessonFrom",
            "label": "Stunde von",
            "type": "Lesson",
            "required": "{{ticket.dateFrom ? true : false}}",
            "indicator": "{{ticket.dateUntil > ticket.dateFrom ? 'from' : ''}}"
        },
        {
            "name": "dateUntil",
            "label": "Datum bis",
            "type": "Date",
            "required": false
        },
        {
            "name": "lessonUntil",
            "label": "Stunde bis",
            "type": "Lesson",
            "required": "{{ticket.dateUntil ? true : false}}",
            "indicator": "{{ticket.dateUntil > ticket.dateFrom ? 'until' : ''}}"
        }
    ],
    "validations": [
        {
            "name": "dateRange",
            "expression": "!ticket.dateFrom || !ticket.dateUntil || ticket.dateFrom <= ticket.dateUntil",
            "message": "Datum von kann nicht nach Datum bis liegen"
        }
    ],
    "grid": [
        "title title title title",
        "badges badges badges badges",
        "description description description description",
        "dateFrom dateFrom lessonFrom lessonFrom",
        "dateUntil dateUntil lessonUntil lessonUntil",
        "assignee assignee assignee assignee"
    ],
    "workflow": [
        {
            "states": [
                "offen.neu",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "bearbeiten",
                    "groups": [
                        "@assignee",
                        "Schulleitung",
                        "Stundenplanung",
                        "Vertretungsplanung"
                    ],
                    "form": "aufgabe.bearbeiten"
                },
                {
                    "name": "ablehnen",
                    "groups": [
                        "Schulleitung",
                        "Stundenplanung",
                        "Vertretungsplanung"
                    ],
                    "script": "ticket.state = 'offen.abgelehnt'"
                },
                {
                    "name": "an Stundenplanung",
                    "groups": [
                        "Stundenplanung",
                        "Vertretungsplanung"
                    ],
                    "script": "convert(ticket)"
                }
            ]
        },
        {
            "states": [
                "offen.neu",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "stornieren",
                    "groups": [
                        "@creator"
                    ],
                    "optional": true,
                    "script": "ticket.state = 'geschlossen.storniert'"
                }
            ]
        },
        {
            "states": [
                "offen.erledigt",
                "offen.abgelehnt"
            ],
            "actions": [
                {
                    "name": "ok",
                    "groups": [
                        "@creator"
                    ],
                    "script": "ticket.state = 'geschlossen.ok'"
                }
            ]
        }
    ],
    "bots": [
        {
            "name": "dringend",
            "script": "dringend(ticket)"
        }
    ],
    "access": [
        {
            "name": "create",
            "groups": [
                "Lehrkräfte"
            ]
        },
        {
            "name": "edit",
            "groups": [
                "Stundenplanung",
                "Vertretungsplanung"
            ]
        },
        {
            "name": "read",
            "groups": [
                "@creator",
                "Stundenplanung",
                "Vertretungsplanung",
                "Schulleitung"
            ]
        },
        {
            "name": "undo",
            "groups": [
                "Schulleitung",
                "Stundenplanung",
                "Vertretungsplanung"
            ]
        },
        {
            "name": "delete",
            "groups": [
                "Schulleitung",
                "Stundenplanung",
                "Vertretungsplanung"
            ]
        },
        {
            "name": "comment",
            "groups": [
                "@creator",
                "Stundenplanung",
                "Vertretungsplanung"
            ]
        }
    ],
    "forms": [
        {
            "name": "aufgabe.bearbeiten",
            "title": "Aufgabe bearbeiten",
            "fields": [
                {
                    "name": "badges",
                    "visible": true
                }
            ],
            "actions": [
                {
                    "name": "abgelehnt",
                    "script": "ticket.state = 'offen.abgelehnt'"
                },
                {
                    "name": "erledigt",
                    "script": "ticket.state = 'offen.erledigt'"
                },
                {
                    "name": "in Arbeit",
                    "script": "ticket.state = 'offen.inArbeit'"
                }
            ]
        }
    ],
    "states": [
        {
            "name": "offen",
            "label": "offen",
            "color": "blue"
        },
        {
            "name": "offen.neu",
            "label": "neu",
            "color": "blue"
        },
        {
            "name": "offen.inArbeit",
            "label": "in Arbeit",
            "color": "yellow"
        },
        {
            "name": "offen.erledigt",
            "label": "erledigt",
            "color": "green"
        },
        {
            "name": "offen.abgelehnt",
            "label": "abgelehnt",
            "color": "red"
        },
        {
            "name": "geschlossen.storniert",
            "label": "storniert",
            "color": "red"
        },
        {
            "name": "geschlossen.ok",
            "label": "ok",
            "color": "green"
        },
        {
            "name": "geschlossen.abgelehnt",
            "label": "abgelehnt",
            "color": "red"
        },
        {
            "name": "geschlossen",
            "label": "geschlossen",
            "color": "green"
        }
    ]
}