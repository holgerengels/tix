{
    "type": "Raumreservierung",
    "abbreviation": "RR",
    "template": "{{ticket.termin.room || 'Raum'}} - {{ticket.date}}",
    "fields": [
        {
            "name": "date",
            "label": "Datum",
            "type": "Date",
            "required": true,
            "validation": {
                "expression": "ticket.state || !ticket.date || ticket.date >= format(now, 'yyyy-MM-dd')",
                "message": "Datum kann nicht in der Vergangenheit liegen"
            }
        },
        {
            "name": "termin",
            "label": "Termin & Raum",
            "type": "Termin",
            "rooms": [
                "Raum 008 (Entspannung)",
                "Raum 318 (Konferenz)",
                "Raum 401 (Recherche)",
                "Raum 405 (Mediathek)",
                "Raum 513 (Besprechung)"
            ],
            "required": true
        },
        {
            "name": "description",
            "visible": false
        }
    ],
    "grid": [
        "title title title title",
        "date date date date",
        "termin termin termin termin"
    ],
    "workflow": [
        {
            "states": [
                "offen.eingetragen"
            ],
            "actions": [
                {
                    "name": "stornieren",
                    "groups": [
                        "@creator",
                        "Schulleitung"
                    ],
                    "optional": true,
                    "script": "ticket.state = 'offen.storniert'"
                }
            ]
        },
        {
            "states": [
                "offen.eingetragen"
            ],
            "actions": [
                {
                    "name": "verschieben",
                    "groups": [
                        "@creator"
                    ],
                    "optional": true,
                    "form": "verschieben"
                }
            ]
        }
    ],
    "access": [
        {
            "name": "create",
            "groups": [
                "Lehrkräfte",
                "Schulleitung"
            ]
        },
        {
            "name": "read",
            "groups": [
                "@creator",
                "Schulleitung"
            ]
        },
        {
            "name": "delete",
            "groups": [
                "Schulleitung"
            ]
        }
    ],
    "bots": [
        {
            "name": "eintragen",
            "states": [
                "offen.neu"
            ],
            "script": "eintragen(ticket)"
        },
        {
            "name": "verschieben",
            "states": [
                "offen.verschoben"
            ],
            "script": "verschieben(ticket, dataBefore)"
        },
        {
            "name": "stornieren",
            "states": [
                "offen.storniert"
            ],
            "script": "stornieren(ticket)"
        },
        {
            "name": "abschliessen",
            "states": [
                "offen.eingetragen"
            ],
            "onChange": "async",
            "schedule": "0 23 * * *",
            "script": "abschliessen(ticket)"
        }
    ],
    "forms": [
        {
            "name": "verschieben",
            "title": "Termin verschieben",
            "actions": [
                {
                    "name": "verschieben",
                    "script": "ticket.state = 'offen.verschoben'"
                }
            ]
        }
    ],
    "states": [
        {
            "name": "offen",
            "label": "offen",
            "color": "blue"
        },
        {
            "name": "offen.neu",
            "label": "neu",
            "color": "blue"
        },
        {
            "name": "offen.eingetragen",
            "label": "reserviert",
            "color": "green"
        },
        {
            "name": "offen.verschoben",
            "label": "verschoben",
            "color": "yellow"
        },
        {
            "name": "offen.storniert",
            "label": "storniere...",
            "color": "yellow"
        },
        {
            "name": "geschlossen.storniert",
            "label": "storniert",
            "color": "red"
        },
        {
            "name": "geschlossen.ok",
            "label": "abgeschlossen",
            "color": "green"
        },
        {
            "name": "geschlossen",
            "label": "geschlossen",
            "color": "green"
        }
    ]
}