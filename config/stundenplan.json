{
    "type": "Stundenplan-Ticket",
    "abbreviation": "STP",
    "template": "{{ ((ticket.day ? ticket.day + ' ' : '') + (ticket.lessons ? '[' + (ticket.lessons.min == ticket.lessons.max ? ticket.lessons.min : ticket.lessons.min + '..' + ticket.lessons.max) + ']' : '')).trim() }}",
    "fields": [
        {
            "name": "assignee",
            "groups": [
                "Stundenplanung"
            ],
            "visible": true
        },
        {
            "name": "description",
            "required": true
        },
        {
            "name": "day",
            "label": "Wochentag",
            "type": "Weekday",
            "required": true
        },
        {
            "name": "lessons",
            "label": "Stunden",
            "type": "Lessons",
            "required": "{{ticket.day ? true : false}}"
        }
    ],
    "validations": [],
    "grid": [
        "title title title title",
        "badges badges badges badges",
        "description description description description",
        "day day lessons lessons",
        "assignee assignee assignee assignee"
    ],
    "workflow": [
        {
            "states": [
                "offen.neu",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "bearbeiten",
                    "groups": [
                        "@assignee",
                        "Schulleitung",
                        "Stundenplanung"
                    ],
                    "form": "bearbeiten"
                },
                {
                    "name": "zuweisen",
                    "groups": [
                        "Stundenplanung"
                    ],
                    "inline": "assign"
                },
                {
                    "name": "ablehnen",
                    "groups": [
                        "Schulleitung",
                        "Stundenplanung"
                    ],
                    "script": "ticket.state = 'offen.abgelehnt'"
                },
                {
                    "name": "an Vertretungsplanung",
                    "groups": [
                        "Stundenplanung"
                    ],
                    "script": "convert(ticket)"
                }
            ]
        },
        {
            "states": [
                "offen.neu",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "stornieren",
                    "groups": [
                        "@creator"
                    ],
                    "optional": true,
                    "script": "ticket.state = 'geschlossen.storniert'"
                }
            ]
        },
        {
            "states": [
                "offen.erledigt",
                "offen.abgelehnt"
            ],
            "actions": [
                {
                    "name": "ok",
                    "groups": [
                        "@creator"
                    ],
                    "script": "ticket.state = 'geschlossen.ok'"
                }
            ]
        }
    ],
    "bots": [
        {
            "name": "dringend",
            "states": [
                "offen.neu"
            ],
            "onChange": "insync",
            "schedule": "0 8 * * 1-5",
            "script": "dringend(ticket)"
        }
    ],
    "access": [
        {
            "name": "create",
            "groups": [
                "Stundenplanung"
            ]
        },
        {
            "name": "edit",
            "groups": [
                "Stundenplanung"
            ]
        },
        {
            "name": "read",
            "groups": [
                "@creator",
                "Stundenplanung",
                "Schulleitung"
            ]
        },
        {
            "name": "undo",
            "groups": [
                "Schulleitung",
                "Stundenplanung"
            ]
        },
        {
            "name": "delete",
            "groups": [
                "Schulleitung",
                "Stundenplanung"
            ]
        },
        {
            "name": "comment",
            "groups": [
                "@creator",
                "Stundenplanung"
            ]
        }
    ],
    "forms": [
        {
            "name": "bearbeiten",
            "title": "Aufgabe bearbeiten",
            "fields": [
                {
                    "name": "badges",
                    "visible": true
                }
            ],
            "actions": [
                {
                    "name": "abgelehnt",
                    "script": "ticket.state = 'offen.abgelehnt'"
                },
                {
                    "name": "erledigt",
                    "script": "ticket.state = 'offen.erledigt'"
                },
                {
                    "name": "in Arbeit",
                    "script": "ticket.state = 'offen.inArbeit'"
                }
            ]
        }
    ],
    "states": [
        {
            "name": "offen.*",
            "label": "offen *",
            "color": "blue"
        },
        {
            "name": "offen.neu",
            "label": "neu",
            "color": "blue"
        },
        {
            "name": "offen.inArbeit",
            "label": "in Arbeit",
            "color": "yellow"
        },
        {
            "name": "offen.erledigt",
            "label": "erledigt",
            "color": "green"
        },
        {
            "name": "offen.abgelehnt",
            "label": "abgelehnt",
            "color": "red"
        },
        {
            "name": "geschlossen.storniert",
            "label": "storniert",
            "color": "red"
        },
        {
            "name": "geschlossen.ok",
            "label": "ok",
            "color": "green"
        },
        {
            "name": "geschlossen.abgelehnt",
            "label": "abgelehnt",
            "color": "red"
        },
        {
            "name": "geschlossen.*",
            "label": "geschlossen (alle)",
            "color": "green"
        }
    ]
}