{
    "type": "Stundenplan-Ticket",
    "abbreviation": "STU",
    "template": "{{day}} {{ lessons ? (lessons.min == lessons.max ? lessons.min : lessons.min + '..' + lessons.max) : '' }}",
    "fields": [
        {
            "name": "assignee",
            "groups": [
                "Stundenplanung"
            ],
            "visible": true
        },
        {
            "name": "description",
            "required": true
        },
        {
            "name": "day",
            "label": "Wochentag",
            "type": "Weekday",
            "required": true
        },
        {
            "name": "lessons",
            "label": "Stunden",
            "type": "Lessons",
            "required": true
        }
    ],
    "grid": [
        "title title title title",
        "badges badges badges badges",
        "description description description description",
        "assignee assignee assignee assignee",
        "day day lessons lessons"
    ],
    "workflow": [
        {
            "states": [
                "offen.neu",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "bearbeiten",
                    "groups": [
                        "@assignee",
                        "Schulleitung",
                        "Stundenplanung"
                    ],
                    "script": "ticket.state = 'offen.inArbeit'",
                    "form": "aufgabe.bearbeiten"
                },
                {
                    "name": "ablehnen",
                    "groups": [
                        "Schulleitung",
                        "Stundenplanung"
                    ],
                    "script": "ticket.state = 'offen.abgelehnt'"
                }
            ]
        },
        {
            "states": [
                "offen.neu",
                "offen.inArbeit"
            ],
            "actions": [
                {
                    "name": "stornieren",
                    "groups": [
                        "@creator"
                    ],
                    "optional": true,
                    "script": "ticket.state = 'geschlossen.storniert'"
                }
            ]
        },
        {
            "states": [
                "offen.erledigt",
                "offen.abgelehnt"
            ],
            "actions": [
                {
                    "name": "ok",
                    "groups": [
                        "@creator"
                    ],
                    "script": "ticket.state = 'geschlossen.ok'"
                }
            ]
        }
    ],
    "access": [
        {
            "name": "create",
            "groups": [
                "Lehrkräfte"
            ]
        },
        {
            "name": "edit",
            "groups": [
                "Stundenplanung"
            ]
        },
        {
            "name": "read",
            "groups": [
                "@creator"
            ]
        },
        {
            "name": "undo",
            "groups": [
                "Schulleitung",
                "Stundenplanung"
            ]
        },
        {
            "name": "delete",
            "groups": [
                "Schulleitung",
                "Stundenplanung"
            ]
        },
        {
            "name": "comment",
            "groups": [
                "@creator",
                "Stundenplanung"
            ]
        }
    ],
    "forms": [
        {
            "name": "aufgabe.bearbeiten",
            "title": "Aufgabe bearbeiten",
            "fields": [
                {
                    "name": "badges",
                    "visible": true
                }
            ],
            "actions": [
                {
                    "name": "abgelehnt",
                    "script": "ticket.state = 'offen.abgelehnt'"
                },
                {
                    "name": "erledigt",
                    "script": "ticket.state = 'offen.erledigt'"
                },
                {
                    "name": "in Arbeit",
                    "script": "ticket.state = 'offen.inArbeit'"
                }
            ]
        }
    ],
    "states": [
        {
            "name": "offen",
            "label": "offen",
            "color": "blue"
        },
        {
            "name": "offen.neu",
            "label": "neu",
            "color": "blue"
        },
        {
            "name": "offen.inArbeit",
            "label": "in Arbeit",
            "color": "yellow"
        },
        {
            "name": "offen.erledigt",
            "label": "erledigt",
            "color": "green"
        },
        {
            "name": "offen.abgelehnt",
            "label": "abgelehnt",
            "color": "red"
        },
        {
            "name": "geschlossen.storniert",
            "label": "storniert",
            "color": "red"
        },
        {
            "name": "geschlossen.ok",
            "label": "geschlossen",
            "color": "green"
        },
        {
            "name": "geschlossen.abgelehnt",
            "label": "abgelehnt",
            "color": "red"
        },
        {
            "name": "geschlossen",
            "label": "geschlossen",
            "color": "green"
        }
    ]
}